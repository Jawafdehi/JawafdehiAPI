# SECRET_KEY is required. Generate one with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here
DEBUG=False
# ALLOWED_HOSTS is required when DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Allow all subdomains of newnepal.workers.dev and jawafdehi.org
CORS_ALLOWED_ORIGIN_REGEXES=^https://([a-z0-9-]+\.)?newnepal\.workers\.dev$,^https://([a-z0-9-]+\.)?jawafdehi\.org$
# For browser cookie-based writes from workers.dev / jawafdehi.org. Django CSRF
# wildcards match subdomains only, so the apex domains are listed explicitly.
CSRF_TRUSTED_ORIGINS=https://*.newnepal.workers.dev,https://newnepal.workers.dev,https://*.jawafdehi.org,https://jawafdehi.org
NES_API_URL=https://nes.jawafdehi.org/api

# Wagtail headless CMS. Base URL for absolute admin links (notification emails,
# preview base); the Wagtail admin lives at /newsroom on this host.
# WAGTAILADMIN_BASE_URL=https://portal.jawafdehi.org
# Where the edit-screen preview iframe is redirected — the public SPA's article
# preview route. Local dev points at the Vite dev server (see vite.config.ts).
# WAGTAIL_HEADLESS_PREVIEW_CLIENT_URL=http://127.0.0.1:40114/updates/preview
DATABASE_URL=postgresql://user:password@localhost:5432/jawafdehi
NGM_DATABASE_URL=postgresql://user:password@localhost:5432/ngm

# Optional read-replica endpoints for the primary/replica split. Point these at
# the CNPG `pg-r` service (primary + standbys, read-only). ORM reads and NGM
# judicial queries are routed here; writes and migrations stay on the URLs
# above. When unset, reads fall back to the primary, so leaving them blank
# preserves the previous single-endpoint behavior.
# DATABASE_READ_URL=postgresql://user:password@pg-r.db.svc.cluster.local:5432/jawafdehi
# NGM_DATABASE_READ_URL=postgresql://user:password@pg-r.db.svc.cluster.local:5432/ngm

# Optional: SSL/TLS for PostgreSQL connections (e.g. Cloud SQL).
# These can also be supplied as URL query params:
#   DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=verify-ca&sslrootcert=/path/to/ca.pem
# DATABASE_SSL_MODE=verify-ca
# DATABASE_SSL_CA_CERT_FILE=/etc/ssl/certs/cloudsql-ca.pem  # default set in Dockerfile
# DATABASE_SSL_CLIENT_CERT_FILE=/path/to/client-cert.pem
# DATABASE_SSL_CLIENT_KEY_FILE=/path/to/client-key.pem
# Fallback variables (used when DATABASE_SSL_* variants are not set):
# SSL_CA_CERT_FILE=/path/to/server-ca.pem
# SSL_CLIENT_CERT_FILE=/path/to/client-cert.pem
# SSL_CLIENT_KEY_FILE=/path/to/client-key.pem

NGM_QUERY_MAX_ROWS=500

# NES Queue System (only needed for GitHub Actions queue processing)
# NES_DB_PATH=/path/to/nes-db

# CIAA Dataset Import Configuration
# Base path for CIAA case JSON files (local or S3/R2)
# Local example: /path/to/local/ciaa/cases
# S3/R2 example: s3://bucket-name/path/to/cases
# CIAA_DATASET_BASE_PATH=s3://your-bucket/path/to/ciaa/cases


# File Storage Configuration (optional in development, required for production)
# Leave blank to use local FileSystemStorage (development)
# Set these to use S3-compatible storage (AWS S3, Cloudflare R2, Minio, etc.)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=jawafdehi
# AWS_S3_REGION_NAME=auto (for Cloudflare R2) or us-east-1 (for AWS)
# AWS_S3_ENDPOINT_URL=https://your-endpoint-url (for Cloudflare R2 or Minio)
# AWS_S3_USE_SSL=True (for remote storage)
# FILE_HASH_SALT=your-secure-salt-for-file-hashing
# FILE_STORAGE_PREFIX=case_uploads/ (prefix for uploaded files)
# MEDIA_URL=/media/ (URL path for media files)
# MEDIA_ROOT=/path/to/media (filesystem path for local storage)


# Case Workflow Configuration
# API token for the Jawafdehi MCP server (jawafdehi-mcp)
# JAWAFDEHI_API_TOKEN=your-jawafdehi-api-token

# Case Workflow LLM Configuration# Model in provider:model format (default: openai:gpt-4o)
# JAWAFDEHI_CASEWORK_MODEL=openai:gpt-4o
# API key for the LLM provider (falls back to provider-specific env var, e.g. OPENAI_API_KEY)
# JAWAFDEHI_CASEWORK_API_KEY=your-api-key
# Base URL for OpenAI-compatible endpoints (e.g. Ollama)
# JAWAFDEHI_CASEWORK_BASE_URL=http://localhost:11434/v1


# Langfuse Observability (optional — traces LLM calls during workflow execution)
# Get your keys at https://cloud.langfuse.com or your self-hosted instance
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

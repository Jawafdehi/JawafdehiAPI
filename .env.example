POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=45432
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=49000
MINIO_CONSOLE_PORT=49001
OPENSEARCH_PORT=49200
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_HOST=localhost
ZITADEL_PORT=48080
OIDC_AUDIENCE=jawafdehi-platform-dev
# Local-only Django SECRET_KEY for the compose stack. Must NOT be one of the
# rejected sentinels (``dev-secret-change-me`` / ``django-insecure-*`` /
# ``dev-insecure-*``) — the settings prod-guard rejects those even though the
# compose `platform` service runs with DEBUG=False (prod-parity). Generate your
# own for any shared/staging use:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
PLATFORM_SECRET_KEY=local-dev-only-9f3a2c7e1b6d4058a1e2c3d4e5f60718
# Unified platform: ONE host port for the single `platform` service, ONE /api/
# surface (entities/materials/courtcases/cases/... — no /nes or /ngm prefixes).
PLATFORM_API_PORT=48000
# Local-dev auth: set DEV_AUTH=true to ALSO accept Django session + HTTP-Basic
# login (plain username/password, e.g. `manage.py createsuperuser`) and expose
# the DRF browsable API + /api-auth/login/, so you don't need Zitadel locally.
# Honored ONLY under DEBUG/TESTING — ignored in production (stays OIDC-only).
DEV_AUTH=true
# Frontend Vite dev server (hot reload) host port. Proxies /api,/admin,/static to
# the platform service inside the compose network.
FRONTEND_PORT=40114
# Newsletter → SendPulse ESP. Leave these UNSET to run without a live ESP: the
# subscribe endpoint then accepts requests (HTTP 202) and logs them instead of
# 500-ing, so the flow is testable before the account is provisioned. (Unsubscribe
# is handled by SendPulse's own hosted link in emails — the backend owns no route.)
#
# Auth, pick ONE. Simplest is a static API key used directly as a Bearer token:
SENDPULSE_API_KEY=
# ...or the classic OAuth client-credentials pair (ignored when API_KEY is set):
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
# Required for either auth mode — the address book to subscribe into:
SENDPULSE_ADDRESSBOOK_ID=
# Optional: outbound SendPulse request timeout (seconds).
# SENDPULSE_TIMEOUT_SECONDS=5

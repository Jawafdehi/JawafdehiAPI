# Integration-test target config. Copy to .env (pytest-dotenv loads it).
# The platform is now a SINGLE monolith image — all apps run in one process
# behind ONE host/port. Set the one base URL; the per-service path prefixes
# (/api, /nes/api, /ngm/api) are handled by the tests.

# The one monolith host (the `platform` service).
PLATFORM_BASE_URL=http://localhost:48000

# Back-compat per-service vars. They are NO LONGER separate ports — leave them
# pointing at the same monolith host. (If unset, they default to PLATFORM_BASE_URL.)
NES_API_BASE_URL=http://localhost:48000
NGM_API_BASE_URL=http://localhost:48000
JAWAFDEHI_API_BASE_URL=http://localhost:48000

# OIDC / Zitadel (platform auth — DRF tokens are NOT used)
OIDC_ISSUER=http://localhost:48080
# Client-credentials app used by the test runner to call the platform.
OIDC_CLIENT_ID=integration-tests
OIDC_CLIENT_SECRET=change-me

# Set to "1" to skip tests when the stack isn't up (instead of failing).
SKIP_IF_STACK_DOWN=0

# The live API applies a DRF AnonRateThrottle, defaulting to a generous 1000/hour
# (settings.py: THROTTLE_RATE_ANON) — well above what this fast suite consumes in
# one run, so the full live suite passes without 429s. To tighten/loosen the live
# rate, set THROTTLE_RATE_ANON on the `platform` service in docker-compose and
# `docker compose up -d platform` (server-side; read at process start, no rebuild).
